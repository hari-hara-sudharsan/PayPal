# ---- PayPal --------------------------------------------------------------
# Leave blank to run the built-in PayPal emulator (labelled SIMULATED in the UI).
# Sandbox credentials: developer.paypal.com > Apps & Credentials > Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Dashboard > your app > Webhooks. Needed to verify inbound webhook signatures.
PAYPAL_WEBHOOK_ID=

# ---- AI (first match wins; none set = offline rules, labelled in the UI) ---
ANTHROPIC_API_KEY=
# Any OpenAI-compatible endpoint also works:
OPENAI_API_KEY=
OPENAI_API_BASE=
AI_MODEL=

# ---- App -----------------------------------------------------------------
PORT=8787
PUBLIC_URL=http://localhost:8787
PLATFORM_FEE_BPS=150
# Bearer token required on /mcp. Blank = open when running the emulator, disabled otherwise.
MCP_TOKEN=
